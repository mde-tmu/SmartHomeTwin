<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FirstFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hub_trigger"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/hub_off"
                app:backgroundTint="@color/off"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/sys_trigger"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/sys_off"
                app:backgroundTint="@color/off"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/network_trigger"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/network_off"
                app:backgroundTint="@color/off"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/garage_door"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/garage_door"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/garage_door_switch"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/off"
                app:backgroundTint="@color/off"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fire_alarm_carbon"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/zero"/>

            <Space
                android:layout_width="3dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/fire_alarm_smoke"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/zero"/>

            <Space
                android:layout_width="3dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/fire_alarm_heat"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/zero"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/light"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/light"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/light_switch"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/off"
                app:backgroundTint="@color/off"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/smart_tv"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/smart_tv"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/smart_tv_switch"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/off"
                app:backgroundTint="@color/off"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/microwave"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/microwave"/>

            <Space
                android:layout_width="7dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/microwave_switch"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:text="@string/off"
                app:backgroundTint="@color/off"/>
        </LinearLayout>
    </LinearLayout>

